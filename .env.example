# Copy to .env and fill in. NEVER commit the real .env.
# All keys are optional — the pipeline runs offline without them.

# Market-data provider (prices + volume)
MARKET_DATA_API_KEY=

# News-data provider (headlines)
NEWS_API_KEY=

# Anthropic API key — activates the LLM-powered bull/bear agents.
# Without it the pipeline uses deterministic rule-based stand-ins.
ANTHROPIC_API_KEY=

# Generic fallback name for the same key (either works)
LLM_API_KEY=

# Broker PAPER account only — trading and withdrawals disabled on the key
PAPER_BROKER_API_KEY=
PAPER_BROKER_API_SECRET=
